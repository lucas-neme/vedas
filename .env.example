# ── Banco de dados (Postgres próprio da loja, dentro da stack) ───────────────
POSTGRES_USER=vedas
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=vedas
# Porta publicada no host para acesso externo ao Postgres (DBeaver/pgAdmin).
POSTGRES_PORT=5433

# ── Aplicação ────────────────────────────────────────────────────────────────
# Porta em que o CRM ficará acessível: http://IP_DO_SERVIDOR:8080
WEB_PORT=8080
JWT_SECRET=gere_um_segredo_longo_e_aleatorio
TZ=America/Sao_Paulo

# ── Usuário administrador criado no primeiro boot ────────────────────────────
# ADMIN_PASSWORD é OBRIGATÓRIA: sem ela a API se recusa a subir num banco vazio.
# Só vale para a criação do primeiro usuário — depois disso a senha do banco
# manda, e você a troca em Usuários › Alterar minha senha.
ADMIN_EMAIL=admin@vedas.com.br
ADMIN_PASSWORD=

# Popula o banco com categorias, marcas e produtos de exemplo (pet shop).
SEED_ON_START=true

# ── Fiscal ───────────────────────────────────────────────────────────────────
# 2 = homologação (testes), 1 = produção
NFE_ENVIRONMENT=2

# ── Backup automático (profile "backup") ─────────────────────────────────────
# docker compose --profile backup up -d
BACKUP_INTERVAL=86400
BACKUP_KEEP_DAYS=14

# ── pgAdmin (profile "tools") ────────────────────────────────────────────────
# docker compose --profile tools up -d  →  http://IP_DO_SERVIDOR:5050
PGADMIN_PORT=5050
PGADMIN_PASSWORD=

# ── Imagens (opcional, caso use registry ao invés de build no Portainer) ─────
# API_IMAGE=registry.local/vedas/api:1.0.0
# WEB_IMAGE=registry.local/vedas/web:1.0.0
