# Normaliza fim de linha: LF no repositório, independente do sistema.
* text=auto eol=lf

# Scripts do Windows precisam de CRLF na cópia de trabalho.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Arquivos que rodam dentro de containers Linux devem ser sempre LF.
Dockerfile      text eol=lf
*.sh            text eol=lf
*.conf          text eol=lf
docker-compose*.yml text eol=lf

# Binários
*.png binary
*.jpg binary
*.webp binary
*.ico binary
